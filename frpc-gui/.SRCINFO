pkgbase = frpc-gui
	pkgdesc = frpc 的图形前端（GPUI）：主页启停隧道，守护进程常驻
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/tc1911/frpc-gui
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = rust
	makedepends = git
	depends = glibc
	depends = gcc-libs
	depends = libxau
	depends = libxcb
	depends = libxdmcp
	depends = libxkbcommon
	depends = libxkbcommon-x11
	optdepends = vulkan-icd-loader: GPU 渲染后端
	optdepends = wayland: Wayland 会话
	optdepends = xorg-xwayland: 只有 X11 会话时需要
	optdepends = frpc: 想用系统里的 frpc，而不是程序自己去 GitHub 下
	options = !debug
	options = !lto
	source = frpc-gui::git+https://github.com/tc1911/frpc-gui.git#tag=v0.1.0
	sha256sums = SKIP

pkgname = frpc-gui
